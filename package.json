{
  "name": "local-capture",
  "version": "0.9.2",
  "description": "Markdown-native local-first quick capture timeline for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "verify:release": "npm run package:release && node scripts/verify-release.mjs",
    "install:vault": "node scripts/install-to-vault.mjs",
    "qa:smoke": "npm run package:release && node scripts/install-to-vault.mjs dist/test-vault",
    "qa:vault": "npm run package:release && node scripts/qa-vault.mjs",
    "test": "vitest run",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "capture",
    "timeline",
    "markdown"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.28.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  }
}
